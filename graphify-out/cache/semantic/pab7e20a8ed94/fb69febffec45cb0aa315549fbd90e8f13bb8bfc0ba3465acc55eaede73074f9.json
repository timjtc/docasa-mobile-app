{"nodes": [{"id": "docs_decision_log", "label": "Decision Log (ADR-lite)", "file_type": "document", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null}, {"id": "docs_decision_log_d_001", "label": "D-001 \u2014 ESP32 module is WROOM", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Resolves Plan OQ #1: GPIO16/17 (PMS7003 UART2) are safe on WROOM, clearing the Plan \u00a77.4 PSRAM-conflict blocker without pin reassignment."}, {"id": "docs_decision_log_d_002", "label": "D-002 \u2014 BLE UUIDs frozen", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Fresh v4 UUIDs (prefix d0ca5a) frozen in Contract \u00a72; firmware and app hard-code the same constants; regeneration forbidden without a new decision entry."}, {"id": "docs_decision_log_d_003", "label": "D-003 \u2014 JSON v1 encoded with ArduinoJson 7.x", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Plan \u00a712.2 library list omitted a JSON library although \u00a73.4 mandates JSON payloads; ArduinoJson added alongside NimBLE-Arduino."}, {"id": "docs_decision_log_d_004", "label": "D-004 \u2014 NVS counter design (uint64 integrals, merged onSec)", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Plan \u00a74.2 gaps: fanSeconds as uint32 overflows (~12 days at max speed, 4.3e10 > 2^32) and runtimeHours/powerOnHours were defined identically; both integrals uint64 and lifecycle counters merged into a single onSec."}, {"id": "docs_decision_log_d_005", "label": "D-005 \u2014 Working firmware = docasa-air-purifier-v4", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "v3 sketch kept pristine forever as byte-diff target for behavior preservation; active v4 sketch seeded byte-identical; FIRMWARE_VERSION scheme 4.0.0=Phase 1, 4.1.0=Phase 2."}, {"id": "docs_decision_log_d_006", "label": "D-006 \u2014 Android-first app target", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "User toolchain is Android Studio; iOS deferred so iOS-specific work is out of all current phase estimates."}, {"id": "docs_decision_log_d_007", "label": "D-007 \u2014 App state management (Riverpod recommendation)", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Pending at entry; recommendation Riverpod 2.x for testability without hardware and DI-friendly fake BLE layer; resolved by D-016 pin."}, {"id": "docs_decision_log_d_008", "label": "D-008 \u2014 App local database (Drift recommendation)", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Pending at entry; Drift (SQLite) recommended for typed queries suited to the downsampling/aggregation pipeline; resolved by D-016 pin."}, {"id": "docs_decision_log_d_009", "label": "D-009 \u2014 Android minSdk", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Recommendation 31 (Android 12+) to avoid the legacy location-permission BLE-scan path; trade-off excludes Android 11 and below; preset to 26 per D-016."}, {"id": "docs_decision_log_d_010", "label": "D-010 \u2014 Security of write commands vs \u00a71.4 freeze", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Pending Phase 5: passkey-on-TFT (Plan \u00a77.8) conflicts with the \u00a71.4 display freeze (finding R3); interim unauthenticated dev builds flagged as accepted MVP risk."}, {"id": "docs_decision_log_d_011", "label": "D-011 \u2014 Filter budgets & preset filter models", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Plan OQ #4: loadBudget/hourBudget are app-side config; ship configurable defaults (~3000 h) until the real filter model is chosen."}, {"id": "docs_decision_log_d_012", "label": "D-012 \u2014 App history retention policy", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Risk 7.21: 1 Hz recording is ~86k samples/day; unbounded growth requires a retention policy; resolved by D-016 with the coded ladder."}, {"id": "docs_decision_log_d_013", "label": "D-013 \u2014 Toolchain pins (Phase 0)", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Tested pinned toolchain for reproducibility: arduino-cli 1.5.1, ESP32 core 3.3.12, FastLED 3.10.8, Adafruit libs, Flutter 3.47.9/Dart 3.13.7; baseline compile clean, 0 warnings (partially resolves OQ #5)."}, {"id": "docs_decision_log_d_014", "label": "D-014 \u2014 NimBLE-Arduino 2.5.2 + ArduinoJson 7.4.3 pinned", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Fulfills D-003's promise of exact pins; API drift note: NimBLE 2.5.2 has no getSubscribedCount() \u2014 CCCD gating via onSubscribe callback with per-characteristic flags reset on disconnect."}, {"id": "docs_decision_log_d_015", "label": "D-015 \u2014 Phases 1+2 merged; bench gates deferred", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Timeline pressure + no hardware: single firmware session ships 4.1.0; v4.1 code-complete and compile-verified but G1/G2 gates (definition of done) deferred to Bench-Runbook; time command handled, resetFilter ignored until Phase 5; diff gate 312 added / 0 removed."}, {"id": "docs_decision_log_d_016", "label": "D-016 \u2014 Phase 3 dependency pins", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Registry moved past anticipated versions: riverpod 3.4.3 (resolves D-007), drift 2.35.3 (resolves D-008; PK Companion Value() gotcha), FBLP 2.3.14, fl_chart 1.3.0, notifications v22 + core library desugaring; retention ladder coded (resolves D-12); minSdk 26 preset; sqlite3_flutter_libs removed (EOL stub)."}, {"id": "docs_decision_log_d_017", "label": "D-017 \u2014 Phase 4 pre-built without hardware (entry-gate deviation)", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "User chose pre-building over blocking on absent hardware: real FBLP transport (lib/ble/fbp/fbp_docasa_connection.dart) behind the unchanged DocasaConnection interface, handshake + permissions, transport switch via --dart-define=DOCASA_REAL_BLE=true so the emulator stays default; runtime-unverified until bench."}, {"id": "docs_decision_log_d_018", "label": "D-018 \u2014 Phase 4 dependency + license (resolves D-011)", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "FBLP 2.x requires a License enum on connect(): License.nonprofit chosen for personal/civil use; permission_handler added for Android runtime permission UX; placeholder FilterBudgets (~3000 h) shipped editable."}, {"id": "docs_decision_log_d_019", "label": "D-019 \u2014 G4 attempted before G1/G2 bench (planned deviation)", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Planned deviation: build a parallel-install BLE-test artifact and run the G4 checklist informally before firmware bench; if BLE misbehaves, distinguish firmware-side from app-side causes; G1/G2 remain required to close Phase 1+2."}, {"id": "docs_decision_log_d_020", "label": "D-020 \u2014 G4 practice round on a real phone", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Connect flow as live device picker (15 s scan, valid ads only, non-tappable diagnostic list); handshake device verification (mfg/model/fw 4.x); permission fix (locationWhenInUse removed \u2014 neverForLocation suffices on API 31+); debugPrint decision trail kept for triage; parallel-install artifact tooling; MainActivity class constant across variants; A34 showed zero DOCASA ads (purifier unpowered)."}, {"id": "docs_decision_log_d_021", "label": "D-021 \u2014 Filter-replacement alert flow", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "User-specified UX supersedes the Phase-5 UI gate held by D-010: in-app modal on threshold, system push when unfocused, 1/day reminder cap, 'replaced' calls DocasaConnection.resetFilter() and invalidates providers; firmware follow-up needed because v4.1.0 still ignores resetFilter."}, {"id": "docs_decision_log_d_022", "label": "D-022 \u2014 Firmware v4.1.1 accepts resetFilter", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Implements Contract \u00a75 line 110: zeroes fanSec+pwfs and persists immediately (a cut right after replacement cannot resurrect counters from the 5-min throttle window), keeps onSec; diff gate additive-only PASS; closes D-021d."}, {"id": "docs_decision_log_d_023", "label": "D-023 \u2014 Branding assets + dark/light theme toggle", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "User-supplied banner PNG chosen by theme brightness; moon/sun switch persists ui.themeMode in the KV table; dark is house default; new DocasaTheme.light() (same cyan seed); re-exports rebuilt; Windows toolchain blockers documented in firmware/README.md."}, {"id": "docs_decision_log_docasaconnection_interface", "label": "DocasaConnection interface", "file_type": "concept", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null}, {"id": "docs_decision_log_device_picker_sheet", "label": "Live device picker bottom sheet", "file_type": "concept", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null}, {"id": "docs_decision_log_handshake_device_verification", "label": "Handshake device verification (mfg/model/fw strings)", "file_type": "concept", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null}, {"id": "docs_decision_log_flutter_blue_plus_2_3_14", "label": "flutter_blue_plus 2.3.14", "file_type": "concept", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null}, {"id": "docs_decision_log_history_retention_ladder", "label": "History retention ladder (24 h / 7 d / 90 d)", "file_type": "rationale", "source_file": "docs/Decision-Log.md", "source_location": null, "source_url": null, "captured_at": "2026-11-01", "author": null, "contributor": null, "rationale": "Bounds unbounded 1 Hz history growth: raw kept 24 h, 1-min aggregates 7 d, 1-h aggregates 90 d; compaction pass every 60 s in lib/data/history_compactor.dart; resolves risk 7.21."}], "edges": [{"source": "docs_decision_log", "target": "docs_decision_log_d_001", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Decision-Log.md", "source_location": null, "weight": 1.0}, {"source": "docs_decision_log", "target": "docs_decision_log_d_002", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Decision-Log.md", "source_location": null, "weight": 1.0}, {"source": "docs_decision_log", "target": "docs_decision_log_d_003", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Decision-Log.md", "source_location": null, "weight": 1.0}, {"source": "docs_decision_log", "target": "docs_decision_log_d_004", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 