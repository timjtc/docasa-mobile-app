{"nodes": [{"id": "docs_ble_protocol_contract_contract_v1", "label": "BLE Protocol Contract v1.0", "file_type": "document", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen single source of truth for the device-app interface; implemented by firmware Phase 2 (docasa-air-purifier-v4.ino) and app Phase 3 (lib/protocol/). Any change requires a Decision-Log entry and a version bump."}, {"id": "docs_ble_protocol_contract_telemetry_service", "label": "DOCASA Telemetry Service (d0ca5a0e-...)", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom 128-bit UUID service frozen per D-002 (prefix d0ca5a); carries Air Quality, Environment, System Status, Filter Counters and Command characteristics; app discovery filters by service UUID, not name."}, {"id": "docs_ble_protocol_contract_air_quality_characteristic", "label": "Air Quality Characteristic (JSON v1)", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys pm1/pm25/pm10/st; device sources pm10Value (actually PM1.0, name trap), pm25Value, pm100Value, overallStage 1-5; notify at 1 Hz tick plus on-change at stage transitions."}, {"id": "docs_ble_protocol_contract_environment_characteristic", "label": "Environment Characteristic (JSON v1)", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys t (C), h (%RH), voc (k\u03a9, qualitative proxy from BME680 gasResistance); 1 Hz notify."}, {"id": "docs_ble_protocol_contract_system_status_characteristic", "label": "System Status Characteristic (JSON v1)", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys fan (commanded target RPM forever - a measured-RPM rpm key would be additive), bat, chg, full, vb; 1 Hz plus on-change for chg/full transitions."}, {"id": "docs_ble_protocol_contract_filter_counters_characteristic", "label": "Filter Counters Characteristic (read-only)", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys fs (RPM s), pwfs (RPM \u00b5g s), on (powered hours) read from NVS; both integrals uint64 end-to-end per D-004; app polls, no notify."}, {"id": "docs_ble_protocol_contract_command_characteristic", "label": "Command Characteristic (write)", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phone-to-device JSON v1 writes: resetFilter (zeroes fanSec+pwfs only, app re-reads to confirm) and time (epoch re-sent on every connect, device epoch untrusted). Unknown/malformed commands ignored silently; no fan-override command (Plan 1.4 restricted list)."}, {"id": "docs_ble_protocol_contract_json_v1_payload_format", "label": "JSON v1 Payload Format", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every payload carries v:1; parsers must ignore unknown keys; key removal/type/semantic change requires protocol v2 with dual-version codec; firmware compatibility is signalled by v, not Firmware Revision string."}, {"id": "docs_ble_protocol_contract_golden_fixtures", "label": "Golden Test Fixtures F1-F7 / X1-X6", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normative valid fixtures must decode exactly; invalid fixtures (not-json, restricted cmd, wrong version, unknown key, out-of-domain values) must be tolerated without error."}, {"id": "docs_ble_protocol_contract_connect_handshake", "label": "App Connect Handshake", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended order: MTU 247 to DIS read to full snapshot read (incl. Filter Counters) to time write to subscribe all notify characteristics. Time authority is the phone only."}, {"id": "docs_ble_protocol_contract_single_central_policy", "label": "Single Central Connection Policy", "file_type": "concept", "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One central at a time; second connection attempt rejected; advertising auto-resumes after disconnect; reconnect with 0.5 to 8 s exponential backoff."}], "edges": [{"source": "docs_ble_protocol_contract_telemetry_service", "target": "docs_ble_protocol_contract_air_quality_characteristic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_ble_protocol_contract_telemetry_service", "target": "docs_ble_protocol_contract_environment_characteristic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/BLE-Protocol-Contract.md", "source_location": null, "weight": 1.0}, {"source": "docs_ble_protocol_contract_telemetry_service", "target": "docs_ble_protocol_contract_system_status_characteristic", "relation": "references", "confidence": "EXTRACTED", "