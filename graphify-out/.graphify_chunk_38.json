{
  "nodes": [
    {"id": "commandcode_skills_ponytail_skill_ponytail", "label": "Ponytail", "file_type": "document", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_skill_lazy_senior_dev_mode", "label": "Lazy Senior Dev Mode", "file_type": "rationale", "rationale": "The best code is the code never written: solve the whole problem with the least new code, and end every reply naming what was skipped and any risk the user must know.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_skill_smallest_complete_change", "label": "Smallest Complete Change", "file_type": "rationale", "rationale": "Decision ladder: skip what nobody asked for; reuse an existing codebase helper; use the stdlib or platform; use an installed dependency (never add one for a few lines); one clear line; else the minimum code that works. The shortest working diff wins once every caller, test and fixture it must touch is known. Never cut validation at trust boundaries, data-loss error handling, security, accessibility or anything the user asked for.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_skill_ponytail_levels", "label": "Ponytail Levels", "file_type": "concept", "rationale": "full (default) follows all rules; lite builds only what was asked and names the smaller option; ultra also questions the request and pushes back before building.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_skill_shortcut_comment_convention", "label": "Shortcut Comment Convention", "file_type": "concept", "rationale": "A shortcut with a known limit gets a code comment in the form 'shortcut: <the limit>, <when to upgrade>' (older form 'ponytail:') so a deferral is a visible, tracked decision instead of silent debt.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_audit_skill_ponytail_audit", "label": "Ponytail Audit", "file_type": "document", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-audit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_audit_skill_repo_quality_audit", "label": "Repo Quality Audit", "file_type": "rationale", "rationale": "Audit like the senior developer who just inherited the repo and will be paged when it breaks. Order of importance: correct, safe, holds under load, tested, fast, lean - lean still matters because every extra line must be read, tested and fixed later. Map first, judge scale against the expected load, every finding needs a concrete case, and the smallest fix wins. One-shot report, changes no code.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-audit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_debt_skill_ponytail_debt", "label": "Ponytail Debt", "file_type": "document", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-debt/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_debt_skill_shortcut_debt_ledger", "label": "Shortcut Debt Ledger", "file_type": "concept", "rationale": "Every shortcut:/ponytail: marker becomes one ledger row with its ceiling and upgrade trigger so a deferral cannot quietly become permanent; markers naming no upgrade trigger get a no-trigger tag because those silently rot. Reads and reports only.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-debt/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_gain_skill_ponytail_gain", "label": "Ponytail Gain", "file_type": "document", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-gain/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_gain_skill_agentic_benchmark_scoreboard", "label": "Agentic Benchmark Scoreboard", "file_type": "concept", "rationale": "Figures are the geometric mean of per-task medians: headless Claude Code (Opus 5.5, default effort) on 39 tasks x 5 runs vs the same agent without the skill; 18 tasks have hidden correctness and safety checks. They are measured on the benchmark, not computed from the current repo.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-gain/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_gain_skill_honesty_boundary", "label": "Honesty Boundary", "file_type": "rationale", "rationale": "Never print a per-repo savings number: the unbuilt version was never written, so there is no real baseline to subtract from in a live repo. The only real per-repo figures come from the /ponytail-debt ledger.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-gain/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_gain_skill_agentic_benchmark_results", "label": "Agentic Benchmark Results", "file_type": "document", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-gain/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_help_skill_ponytail_help", "label": "Ponytail Help", "file_type": "document", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-help/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_help_skill_default_mode_resolution", "label": "Default Mode Resolution", "file_type": "concept", "rationale": "PONYTAIL_DEFAULT_MODE env var > config file defaultMode (~/.config/ponytail/config.json) > full; 'off' disables auto-activation so /ponytail is used manually.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-help/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_review_skill_ponytail_review", "label": "Ponytail Review", "file_type": "document", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "commandcode_skills_ponytail_review_skill_diff_quality_review", "label": "Diff Quality Review", "file_type": "rationale", "rationale": "Review like the senior developer who will be paged when it breaks: correct, safe, holds under load, tested, fast, lean. Read the diff then the code it touches; a change can break callers it does not touch, so grep every caller when a signature, return value or behavior changes. Every finding needs a concrete case; the smallest fix wins and fixes that delete code are preferred. Lists findings, changes no code.", "source_file": "/home/timothyjtc/proj/docasa-app/.commandcode/skills/ponytail-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
